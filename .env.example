# Copy for manual configuration, or run make env to generate local disposable values.
# Three distinct generated local passwords; do not use for production.
POSTGRES_PASSWORD=replace-with-generated-admin-password
MIGRATION_PASSWORD=replace-with-generated-migration-password
RUNTIME_PASSWORD=replace-with-generated-runtime-password
POSTGRES_PORT=54329
HTTP_PORT=8080
BOOTSTRAP_DATABASE_URL=postgres://judeos_dev:replace-with-generated-admin-password@127.0.0.1:54329/judeos_dev?sslmode=disable
MIGRATION_DATABASE_URL=postgres://judeos_migrator:replace-with-generated-migration-password@127.0.0.1:54329/judeos_dev?sslmode=disable
DATABASE_URL=postgres://judeos_runtime:replace-with-generated-runtime-password@127.0.0.1:54329/judeos_dev?sslmode=disable
# HTTP_ADDR=127.0.0.1:8080
# WEB_DIR=apps/web/dist
# API_DIR=api/dist
# Optional proxy CA: pass BUILD_CA_PATH to make (see ops/README.md).

# Exact HTTPS browser origin; empty disables staff access (403), health/docs remain.
PUBLIC_ORIGIN=

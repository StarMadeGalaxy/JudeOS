      }
    },
    "schemas": {
      "RescheduleSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "base_version",
          "starts_at",
          "ends_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "base_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC, RFC 3339 с Z; дата списка вычисляется в зоне клуба.",
            "pattern": "Z$"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "description": "Необязательная причина; отсутствие и пустая строка нормализуются одинаково; null запрещён."
          }
        }
      },
      "CancelSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "base_version"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "base_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "description": "Необязательная причина; отсутствие и пустая строка нормализуются одинаково; null запрещён."
          }
        }
      },
      "SetSessionCoachesRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "base_version",
          "coach_membership_ids"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "base_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "coach_membership_ids": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "description": "Необязательная причина; отсутствие и пустая строка нормализуются одинаково; null запрещён."
          }
        }
